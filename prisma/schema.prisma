// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Image {
  id             String   @id @default(cuid())
  code           String?  @unique
  year           Int?
  month          Int?
  seqNumber      Int?
  title          String
  keywords       String
  category       String?
  tags           String?
  notes          String?
  status         String   @default("pending") // pending, uploaded, published
  filePath       String
  ssId           String?
  asId           String?
  vzId           String?
  ssDownloads    Int      @default(0)
  asDownloads    Int      @default(0)
  totalDownloads Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  stats          PlatformStats[]
  collections    CollectionItem[]
  serpItems      SerpItem[]

  @@index([createdAt])
  @@index([totalDownloads])
}

model PlatformStats {
  id              String   @id @default(cuid())
  imageId         String?
  image           Image?   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  platform        String   // "Shutterstock", "Adobe Stock", etc.
  platformAssetId String?  // Microstock platform Asset ID (e.g. "1929092005")
  downloads       Int      @default(0)
  earnings        Float    @default(0)
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([imageId, platform, date])
  @@index([platform, platformAssetId])
  @@index([date])
  @@index([imageId])
}

model Collection {
  id          String           @id @default(cuid())
  name        String
  description String?
  coverId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  imageId      String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  image        Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, imageId])
  @@index([collectionId])
  @@index([imageId])
}

model PayoutTransaction {
  id                String    @id @default(cuid())
  stockWithdrawDate DateTime
  stockName         String    // "Shutterstock", "Adobe Stock", "Vecteezy", "123RF", etc.
  stockAmountUsd    Float
  platformDate      DateTime?
  platformName      String    @default("Payoneer") // "Payoneer", "PayPal", etc.
  platformAmountUsd Float?
  feeUsd            Float?
  bankReceivedDate  DateTime?
  bankName          String?   // "Kasikornbank", "SCB", "Bangkok Bank", etc.
  exchangeRate      Float?
  netIncomeThb      Float?
  status            String    @default("pending") // "pending", "in_platform", "completed"
  taxYear           Int?
  leadTimeDays      Int?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stockName])
  @@index([platformName])
  @@index([status])
  @@index([taxYear])
  @@index([stockWithdrawDate])
}

model SerpQuery {
  id           String     @id @default(cuid())
  keyword      String
  platform     String     @default("Adobe Stock")
  pageNumber   Int        @default(1)
  totalItems   Int        @default(0)
  myItemsCount Int        @default(0)
  searchedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        SerpItem[]

  @@index([keyword])
  @@index([platform])
  @@index([searchedAt])
}

model SerpItem {
  id             String    @id @default(cuid())
  serpQueryId    String
  serpQuery      SerpQuery @relation(fields: [serpQueryId], references: [id], onDelete: Cascade)
  rank           Int
  assetId        String
  title          String
  author         String?
  thumbnailUrl   String?
  detailUrl      String?
  isMine         Boolean   @default(false)
  matchedImageId String?
  matchedImage   Image?    @relation(fields: [matchedImageId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([serpQueryId])
  @@index([assetId])
  @@index([matchedImageId])
  @@index([isMine])
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


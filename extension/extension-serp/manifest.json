{
  "manifest_version": 3,
  "name": "Stock SERP Copier",
  "version": "1.0.0",
  "description": "Extract, copy, and export public search rankings and metadata from stock photo platforms.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://stock.adobe.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stock SERP Copier",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://stock.adobe.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
